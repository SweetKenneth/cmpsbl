{
    "name": "promptfluid/clarity",
    "description": "AI-powered WCAG 2.2 accessibility scanner for WordPress",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "version": "3.0.0",
    "authors": [
        {
            "name": "PromptFluid",
            "email": "support@promptfluid.com",
            "homepage": "https://www.promptfluid.com"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "autoload": {
        "psr-4": {
            "PromptFluid_Clarity\\": "includes/"
        },
        "classmap": [
            "includes/",
            "admin/",
            "public/"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
