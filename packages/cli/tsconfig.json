{
  "compilerOptions": {
    "target": "ES2020", "module": "commonjs", "lib": ["ES2020"],
    "declaration": true, "strict": true, "outDir": "dist", "rootDir": "src",
    "esModuleInterop": true, "skipLibCheck": true, "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@cmpsbl/runtime": ["../runtime/src/index.ts"],
      "@cmpsbl/types": ["../types/src/index.ts"]
    }
  },
  "include": ["src"]
}
