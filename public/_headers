# Cache hashed assets immutably (1 year) — filenames change on every build
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache static images for 30 days
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000
/*.ico
  Cache-Control: public, max-age=2592000
